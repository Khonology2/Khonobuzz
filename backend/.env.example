# ── Sentry (backend) ─────────────────────────────────────────────
# Create a backend project at sentry.io (org: khonology-2w).
# BACKEND_DSN is canonical; SENTRY_DSN is accepted for backward compatibility.
# Leave empty to disable Sentry in local dev.
BACKEND_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=khonobuzz-backend@1.0.0
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_SERVER_NAME=khonobuzz-backend
SENTRY_SERVER_VERSION=1.0.0
