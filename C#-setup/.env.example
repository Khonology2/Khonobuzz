# Firebase credentials (required - same as Python backend)
# Option 1: JSON string (recommended for Render)
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...",...}

# Option 2: Path to JSON file
# FIREBASE_CREDENTIALS_PATH=path/to/firebase-adminsdk-xxxxx.json

# PDH Firestore (optional - second Firebase project for PDH sync)
# PDH_FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
# PDH_FIREBASE_CREDENTIALS_PATH=path/to/pdh-firebase-adminsdk.json

# Fernet encryption key (required for token encryption - must match Python's ENCRYPTION_KEY)
# ENCRYPTION_KEY=base64url-encoded-32-byte-key
